# ============================================================
# Dependencies
# ============================================================
# npm / Node.js dependency directory — never commit these
node_modules/

# ============================================================
# Next.js Build Output
# ============================================================
# Next.js production build directory
.next/

# Next.js static export output
out/

# ============================================================
# General Build & Distribution Artifacts
# ============================================================
# Generic build / bundled output directories
dist/
build/

# ============================================================
# Testing & Coverage
# ============================================================
# Test coverage reports generated by tools such as Jest, Vitest, or Istanbul
coverage/

# ============================================================
# Monorepo & Build Orchestration
# ============================================================
# Turborepo cache (even if not part of a monorepo right now, prevents accidental commits)
.turbo/

# ============================================================
# Deployment Platform Caches
# ============================================================
# Vercel deployment output & local development cache
.vercel/

# ============================================================
# Environment Variables
# ============================================================
# Local environment files containing secrets — commit the .env.example or
# documented template instead, never real credentials
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
.env*.local    # catches any future .env.<custom>.local variants

# ============================================================
# Package Manager Debug Logs
# ============================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# OS-Generated Files
# ============================================================
# macOS Finder metadata files
.DS_Store
# macOS folder attribute store
.AppleDouble
# macOS resource fork / ._ prefix files
._*

# Windows thumbnail cache
Thumbs.db
# Windows folder attribute store
ehthumbs.db
# Windows Explorer desktop.ini
Desktop.ini

# Linux directory metadata
.directory

# ============================================================
# General Log Files
# ============================================================
*.log

# ============================================================
# Editor & IDE
# ============================================================
# VS Code — keep workspace-level config (tasks.json, extensions.json, launch.json)
# so the team shares a consistent dev experience, but ignore user-specific settings
.vscode/settings.json

# JetBrains / IntelliJ IDEs
.idea/

# Vim swap / undo files
*.swp
*.swo
*~

# ============================================================
# TypeScript
# ============================================================
# TypeScript incremental build info — generated by tsc --incremental or
# Next.js's TypeScript compilation; is redundant with the .next cache
*.tsbuildinfo
next-env.d.ts

# ============================================================
# Binary & Archive Files
# ============================================================
# Prevent accidental commits of binary libraries, archives, and installers
*.exe
*.dll
*.so
*.dylib
*.bin
*.obj
*.o
*.a
*.lib
*.exp
*.pdb
*.ilk
*.7z
*.zip
*.tar
*.gz
*.rar

# ============================================================
# Misc
# ============================================================
# Lock files for alternative package managers (npm's package-lock.json is
# intentionally COMMITTED — do NOT ignore it). If someone on the team
# accidentally runs yarn or pnpm, these are noise.
yarn.lock
pnpm-lock.yaml
